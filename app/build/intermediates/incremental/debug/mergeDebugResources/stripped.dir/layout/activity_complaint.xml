<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCE4EC"
    android:padding="16dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. Incident Overview -->
        <TextView
            android:text="1. Incident Overview"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#880E4F"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <Spinner
            android:id="@+id/spinner_category"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/btn_dropdown"/>

        <Button
            android:id="@+id/btn_date_picker"
            android:text="Select Date/Time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

        <Switch
            android:id="@+id/switch_ongoing"
            android:text="Is this an ongoing threat?"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>

        <!-- 2. Location & Identification -->
        <TextView
            android:text="2. Location &amp; Identification"
            android:textStyle="bold"
            android:textColor="#880E4F"
            android:layout_marginTop="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/et_location"
            android:hint="Location/Landmarks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPostalAddress"/>

        <EditText
            android:id="@+id/et_vehicle"
            android:hint="Vehicle Info (Plate, Color)"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"/>

        <EditText
            android:id="@+id/et_individual_desc"
            android:hint="Describe individual (Height, Clothing)"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"/>

        <!-- 3. Detailed Evidence -->
        <TextView
            android:text="3. Detailed Evidence"
            android:textStyle="bold"
            android:textColor="#880E4F"
            android:layout_marginTop="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <EditText
            android:id="@+id/et_description"
            android:hint="Describe the incident"
            android:inputType="textMultiLine"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:gravity="top"
            android:padding="10dp"
            android:background="@android:drawable/edit_text"/>

        <EditText
            android:id="@+id/et_witnesses"
            android:hint="Were there any witnesses?"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btn_upload"
            android:text="Upload Evidence (Photos/Audio)"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#AD1457"/>

        <!-- 4. Safety & Privacy -->
        <TextView
            android:text="4. Safety &amp; Privacy"
            android:textStyle="bold"
            android:textColor="#880E4F"
            android:layout_marginTop="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Contact Preference:"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>

        <RadioGroup
            android:id="@+id/rg_contact_pref"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton android:id="@+id/rb_in_app" android:text="In-app notification" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <RadioButton android:id="@+id/rb_call" android:text="Phone call" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <RadioButton android:id="@+id/rb_sms" android:text="SMS" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </RadioGroup>

        <Switch
            android:id="@+id/switch_anonymous"
            android:text="Remain anonymous?"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>

        <CheckBox
            android:id="@+id/checkbox_medical_support"
            android:text="Require medical/psychological support?"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>

        <!-- Final Submit -->
        <Button
            android:id="@+id/btn_submit"
            android:text="SUBMIT REPORT"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#C2185B"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="18sp"/>
    </LinearLayout>
</ScrollView>